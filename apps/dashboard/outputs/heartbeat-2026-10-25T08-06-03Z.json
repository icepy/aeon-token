        "green-heading",
        "green-text",
        "sep4",
        "pending-heading",
        "pending-text",
        "sep5",
        "source-heading",
        "source-text"
      ]
    },
    "header-badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
